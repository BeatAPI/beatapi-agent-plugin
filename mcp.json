{
  "mcpServers": {
    "beatapi": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./mcp/server.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "BEATAPI_API_KEY": "${BEATAPI_API_KEY}",
        "BEATAPI_BASE_URL": "${BEATAPI_BASE_URL}",
        "BEATAPI_TRUST_CUSTOM_BASE_URL": "${BEATAPI_TRUST_CUSTOM_BASE_URL}",
        "BEATAPI_UPLOAD_ROOTS": "${BEATAPI_UPLOAD_ROOTS}"
      }
    }
  }
}
