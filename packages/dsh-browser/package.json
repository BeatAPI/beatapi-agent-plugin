{
  "name": "@beatapi/dsh-browser",
  "version": "0.1.0",
  "description": "BeatBrowser signed-in Chrome TaskSpace connector for DeepSeek Harness.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "*.mjs",
    "cordis.patch.yml",
    "SKILL.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": "0.1.0-rc.6 || 0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.6 || 0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "license": "MIT",
  "author": "BeatAPI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatAPI/beatapi-agent-plugin.git",
    "directory": "packages/dsh-browser"
  },
  "homepage": "https://github.com/BeatAPI/beatapi-agent-plugin/tree/main/packages/dsh-browser",
  "bugs": {
    "url": "https://github.com/BeatAPI/beatapi-agent-plugin/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "beatapi",
    "browser"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@beatapi/beat-browser": "1.4.1"
  }
}
