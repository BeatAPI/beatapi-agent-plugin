{
  "name": "@beatapi/dsh-social",
  "version": "0.1.1",
  "description": "Social post, account and comment research with source tables for DeepSeek Harness.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "*.mjs",
    "cordis.patch.yml",
    "SKILL.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-settings": "*",
