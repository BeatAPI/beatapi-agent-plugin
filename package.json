{
  "name": "beatapi-agent-plugin",
  "version": "0.4.0",
  "private": true,
  "description": "Cross-host Agent plugin for BeatAPI, the professional capability layer for any agent.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-mcp.mjs",
    "build:check": "node scripts/build-mcp.mjs --check",
    "ui:build": "node scripts/build-chatgpt-ui.mjs",
    "ui:preview": "node scripts/preview-chatgpt-ui.mjs",
    "contract:sync": "node scripts/contract.mjs --write",
    "contract:check": "node scripts/contract.mjs --check",
    "runtime:sync": "node scripts/sync-runtime.mjs --write",
    "runtime:check": "node scripts/sync-runtime.mjs --check",
    "skill:sync": "node scripts/sync-skill.mjs --write",
    "skill:check": "node scripts/sync-skill.mjs --check",
    "marketplace:build": "node scripts/build-marketplace.mjs",
    "cursor:build": "node scripts/build-cursor.mjs",
    "cursor:check": "node scripts/build-cursor.mjs --check",
    "privacy:check": "node scripts/check-public-boundary.mjs",
    "validate:cursor": "node scripts/validate-cursor.mjs",
    "validate:grok": "node scripts/validate-grok.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "submission:build": "node scripts/build-submission.mjs",
    "submission:check": "node scripts/build-submission.mjs --check",
    "submission:listing": "node scripts/build-submission.mjs --export-listing",
    "submission:probe": "node scripts/build-submission.mjs --probe",
    "submission:catalog": "node scripts/build-remote-catalog.mjs",
    "verify": "npm run privacy:check && npm run contract:check && npm run skill:check && npm run runtime:check && npm run cursor:check && npm run claude:check && npm run validate:cursor && npm run validate:grok && npm run typecheck && npm run ui:build && npm test && npm run build:check && npm run marketplace:build && npm run submission:check && npm run harness:check",
    "harness:sync": "node scripts/sync-harness.mjs",
    "harness:check": "node scripts/sync-harness.mjs --check && node --test harness/test/*.test.mjs",
    "claude:build": "node scripts/build-claude.mjs",
    "claude:check": "node scripts/build-claude.mjs --check"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.1",
    "lucide": "1.69.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
